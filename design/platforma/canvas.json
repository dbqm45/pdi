    "s1": {
      "x": 3400,
      "y": 1300,
      "w": 420,
      "text": "Sample data: sprintdeck built through the whole ecosystem. Screens read from the existing APIs (pdi, ci_for_sdlc, ShipScope's service API); tf works in the product repo. Values in brackets, such as [COST], are to be decided.",
      "fill": "gray"
    },
    "s2": {
      "x": 3040,
      "y": 2600,
      "w": 420,
      "text": "Consistency = ci_for_sdlc: findings (GAP, CONFLICT, AMBIGUITY, OUTDATED, MISSING_COVERAGE, DRIFT) across eight dimensions, each with evidence from its sources. A decision resolves a finding by choosing an option, accepts the risk with a reason and a review date, or dismisses it; it goes to the pdi register as DEC-n.",
      "fill": "blue"
    },
    "s3": {
      "x": 4560,
      "y": -1500,
      "w": 420,
      "text": "The simple version replaces the menu with one question: where is each change, and is it my turn? Eight stages in plain words, four colours (You decide, AI is working, Waiting, Done), one sentence and at most one button per change. The detailed screens below stay one click away as “details”.",
      "fill": "green"
    },
    "t2": {
      "x": 6080,
      "y": -1800,
      "text": "Polished version: the same simple model, product-grade UI",
      "kind": "title1",
      "maxW": 4800
    }
