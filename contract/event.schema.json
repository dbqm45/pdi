{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dbqm45/pdi/contract/event.schema.json",
  "title": "Zdarzenie (pdi, kontrakt 0.3.0)",
  "description": "Koperta zdarzenia wymienianego między pdi, tf, ci_for_sdlc i ShipScope; treść (payload) zależy od typu.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "occurred_at",
    "source",
    "contract_version",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unikalny identyfikator zdarzenia (np. UUID) — do deduplikacji u odbiorcy."
    },
    "type": {
      "type": "string",
      "enum": [
        "problem.accepted",
        "gate.requested",
        "gate.decided",
        "readiness.changed",
        "feature.released",
        "metric.breached",
        "decision.basis_invalidated"
      ]
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "type": "string",
      "enum": [
        "pdi",
        "tf",
        "ci_for_sdlc",
        "shipscope"
      ]
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "problem.accepted"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/problem_accepted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "gate.requested"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/gate_requested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "gate.decided"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/gate_decided"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "readiness.changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/readiness_changed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "feature.released"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/feature_released"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "metric.breached"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/metric_breached"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision.basis_invalidated"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/decision_basis_invalidated"
          }
        }
      }
    }
  ],
  "$defs": {
    "problem_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "change",
        "decision"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "PRB"
        },
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "DEC"
        },
        "project": {
          "type": "string"
        }
      }
    },
    "gate_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "gate",
        "summary"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "gate": {
          "type": "string",
          "minLength": 1,
          "description": "B1–B6 albo nazwa bramki, np. design-review, approve-for-implementation."
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gate_decided": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "gate",
        "outcome",
        "decision"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "approved",
            "changes_requested",
            "rejected"
          ]
        },
        "decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "DEC"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "readiness_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "readiness"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "readiness": {
          "type": "string",
          "enum": [
            "ready",
            "not_ready",
            "drift"
          ]
        },
        "open_questions": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        }
      }
    },
    "feature_released": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "released_at"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
            "description": "TSK"
          }
        },
        "version": {
          "type": "string"
        },
        "released_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "environment": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "metric_breached": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "value",
        "threshold"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "window": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "diagnosis": {
          "type": "string"
        }
      }
    },
    "decision_basis_invalidated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "assumption",
        "signal",
        "attention_level"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "DEC"
        },
        "assumption": {
          "type": "string",
          "minLength": 1,
          "description": "Założenie nośne, którego dotyczy sygnał."
        },
        "signal": {
          "type": "string",
          "minLength": 1,
          "description": "Co się stało (zgodne z invalidated_if)."
        },
        "signal_source": {
          "type": "string",
          "description": "ID zdarzenia, zgłoszenia albo URL źródła."
        },
        "attention_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Poziom uwagi 0–3 (dokument 05)."
        }
      }
    }
  }
}
