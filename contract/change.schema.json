{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dbqm45/pdi/contract/change.schema.json",
  "title": "Nagłówek artefaktu zmiany CHG (pdi, kontrakt 0.10.0)",
  "description": "Nagłówek YAML pliku w docs/project/changes/CHG-n/. Nagłówek artefaktu tf (core-project-record) + pola change, source, tasks. Prosty YAML: wartości to tekst, liczba albo lista tekstów.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "phase",
    "status",
    "version",
    "created",
    "updated",
    "change"
  ],
  "properties": {
    "artifact": {
      "type": "string",
      "enum": [
        "intent",
        "requirements",
        "design",
        "plan",
        "decisions",
        "run"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "discovery",
        "domain",
        "requirements",
        "architecture",
        "plan",
        "delivery",
        "review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "superseded",
        "rejected"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
      "description": "Zmiana, której dotyczy artefakt, domyślnie CHG-n."
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
      "description": "Zgłoszenie, z którego wyszła zmiana (PRB-n); brak dla pomysłu bez zgłoszenia."
    },
    "source_reported_at": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Dzień zgłoszenia `source` (problem.reported_at) — początek lead time od zgłoszenia w ShipScope; od 0.5.0."
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
        "description": "Cięcie (TSK-n) — tylko w plan.md."
      }
    },
    "superseded_by": {
      "type": "string"
    }
  }
}
