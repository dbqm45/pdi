{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dbqm45/pdi/contract/triage-recommendation.schema.json",
  "title": "Rekomendacja triażu zgłoszenia PRB (pdi, kontrakt 0.6.0)",
  "description": "Rekomendacja, którą wykonawca triażu (tf, F3) składa dla pdi. Stan i pola jak w problem.schema.json (R7), żeby pdi przepisało je do zgłoszenia bez tłumaczenia; tf_state z tabeli mapowania w contract/README.md. Decyzję podejmuje człowiek w pdi (triaż jest typem chronionym); zmianę (change) tworzy pdi po przyjęciu.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem",
    "contract_version",
    "recommended_status",
    "tf_state",
    "rationale",
    "drafted_by"
  ],
  "properties": {
    "problem": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
      "description": "Zgłoszenie, którego dotyczy rekomendacja."
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "recommended_status": {
      "type": "string",
      "enum": [
        "clarifying",
        "accepted",
        "rejected",
        "parked",
        "duplicate"
      ],
      "description": "Stan pdi (R7). new i ready_for_triage to stany wejścia, nie wynik triażu."
    },
    "tf_state": {
      "type": "string",
      "enum": [
        "needs-triage",
        "needs-info",
        "ready-for-agent",
        "ready-for-human",
        "wontfix"
      ],
      "description": "Stan tf proc-issue-triage z tabeli mapowania w contract/README.md."
    },
    "tf_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Dodatkowe etykiety tf, np. deferred przy parked."
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "enhancement"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "description": "Uzasadnienie dla decydującego."
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Pytania do zgłaszającego (clarifying)."
    },
    "executor": {
      "type": "string",
      "enum": [
        "agent",
        "human"
      ]
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "description": "Brief dla wykonawcy (accepted)."
    },
    "rejection_reason": {
      "type": "string",
      "enum": [
        "out_of_strategy",
        "works_as_designed",
        "cost_disproportionate",
        "already_exists",
        "out_of_scope_recorded",
        "other"
      ]
    },
    "rejection_note": {
      "type": "string"
    },
    "out_of_scope_file": {
      "type": "string",
      "pattern": "^\\.out-of-scope/.+\\.md$",
      "description": "Wpis w .out-of-scope/ repo (out_of_scope_recorded)."
    },
    "return_when": {
      "type": "string",
      "minLength": 1,
      "description": "Próg powrotu (parked), np. 3 nowe zgłoszenia albo incydent."
    },
    "duplicate_of": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "epistemic_status"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string"
          },
          "epistemic_status": {
            "type": "string",
            "enum": [
              "observation",
              "interpretation",
              "hypothesis",
              "ai_inference"
            ]
          }
        }
      }
    },
    "drafted_by": {
      "type": "string",
      "enum": [
        "ai",
        "human"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recommended_status": {
            "const": "clarifying"
          }
        },
        "required": [
          "recommended_status"
        ]
      },
      "then": {
        "required": [
          "questions"
        ],
        "properties": {
          "tf_state": {
            "const": "needs-info"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recommended_status": {
            "const": "accepted"
          }
        },
        "required": [
          "recommended_status"
        ]
      },
      "then": {
        "required": [
          "brief",
          "executor"
        ],
        "properties": {
          "tf_state": {
            "enum": [
              "ready-for-agent",
              "ready-for-human"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "const": "human"
          }
        },
        "required": [
          "executor"
        ]
      },
      "then": {
        "properties": {
          "tf_state": {
            "const": "ready-for-human"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "const": "agent"
          }
        },
        "required": [
          "executor"
        ]
      },
      "then": {
        "properties": {
          "tf_state": {
            "const": "ready-for-agent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recommended_status": {
            "const": "rejected"
          }
        },
        "required": [
          "recommended_status"
        ]
      },
      "then": {
        "required": [
          "rejection_reason"
        ],
        "properties": {
          "tf_state": {
            "const": "wontfix"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rejection_reason": {
            "const": "out_of_scope_recorded"
          }
        },
        "required": [
          "rejection_reason"
        ]
      },
      "then": {
        "required": [
          "out_of_scope_file"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "recommended_status": {
            "const": "parked"
          }
        },
        "required": [
          "recommended_status"
        ]
      },
      "then": {
        "required": [
          "return_when"
        ],
        "properties": {
          "tf_state": {
            "const": "needs-triage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recommended_status": {
            "const": "duplicate"
          }
        },
        "required": [
          "recommended_status"
        ]
      },
      "then": {
        "required": [
          "duplicate_of"
        ],
        "properties": {
          "tf_state": {
            "const": "wontfix"
          }
        }
      }
    }
  ]
}
