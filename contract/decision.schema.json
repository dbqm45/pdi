{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dbqm45/pdi/contract/decision.schema.json",
  "title": "Decyzja (pdi, kontrakt 0.10.0)",
  "description": "Jedna decyzja w rejestrze pdi albo w nagłówku wpisu changes/CHG-n/decisions.md. Pola: docs/14-pdi-standalone.md §4.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "why",
    "decided_at",
    "decided_by",
    "kind",
    "source",
    "status",
    "drafted_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
      "description": "Nadawane przez rejestr."
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "description": "Co zdecydowano, jedno zdanie."
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "description": "Uzasadnienie, 1–5 zdań."
    },
    "decided_at": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Moment zapisu w rejestrze (UTC), nadawany przez rejestr."
    },
    "kind": {
      "type": "string",
      "enum": [
        "product",
        "technical",
        "process",
        "triage",
        "intent",
        "gate",
        "other"
      ]
    },
    "decision_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "Stały klucz typu decyzji dla poziomów autonomii, np. flag.stage_advance; katalog w contract.json → autonomy."
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Projekt, którego dotyczy decyzja (np. nazwa repo); wyznacza katalog decisions/<project>/. Brak = decyzja ogólna."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "claude-cli",
            "claude-ai",
            "slack",
            "confluence",
            "jira",
            "manual",
            "console",
            "ci_for_sdlc",
            "meeting"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option",
          "chosen"
        ],
        "properties": {
          "option": {
            "type": "string",
            "minLength": 1
          },
          "chosen": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "epistemic_status"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string"
          },
          "epistemic_status": {
            "type": "string",
            "enum": [
              "observation",
              "interpretation",
              "hypothesis",
              "ai_inference"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "load_bearing",
          "invalidated_if"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "load_bearing": {
            "type": "boolean"
          },
          "invalidated_if": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "success_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "target"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "horizon": {
          "type": "string"
        }
      }
    },
    "review_by": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "superseded",
        "reverted"
      ]
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prb": {
          "type": "string"
        },
        "chg": {
          "type": "string"
        },
        "tsk": {
          "type": "string"
        },
        "pr": {
          "type": "string"
        },
        "adr": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "drafted_by": {
      "type": "string",
      "enum": [
        "ai",
        "human"
      ]
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "description": "Decyzja podjęta przez automat (poziom 0–2). Decyzja człowieka (poziom 3) nie ma tego pola.",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "description": "Warunek, który spełnił automat."
        },
        "veto_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "vetoed_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": 2
              }
            },
            "required": [
              "level"
            ]
          },
          "then": {
            "required": [
              "veto_until"
            ]
          }
        }
      ]
    },
    "draft_edited": {
      "type": "boolean",
      "description": "Czy człowiek zmienił szkic AI przed zatwierdzeniem (podstawa odsetka akceptacji, DA2)."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "draft_edited"
        ]
      },
      "then": {
        "properties": {
          "drafted_by": {
            "const": "ai"
          }
        }
      }
    }
  ]
}
