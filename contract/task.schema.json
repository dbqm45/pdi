{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dbqm45/pdi/contract/task.schema.json",
  "title": "Cięcie TSK (pdi, kontrakt 0.9.0)",
  "description": "Cięcie pionowe zmiany, osobny klucz z rodzicem CHG (jak sub-task w Jirze). Opisane w plan.md zmiany; ten schemat służy do wymiany między pdi, tf i ShipScope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "parent",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
      "description": "Klucz cięcia, domyślnie TSK-n."
    },
    "parent": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
      "description": "Zmiana-rodzic, domyślnie CHG-n."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "string",
      "description": "Jaką wartość daje cięcie samo w sobie."
    },
    "verification": {
      "type": "string",
      "description": "Jak sprawdzić, że działa."
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "in_review",
        "done",
        "dropped"
      ]
    },
    "pr": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "slice",
        "foundation"
      ],
      "description": "Cięcie pionowe (S-NN w tf) albo fundament (F-NN)."
    },
    "release": {
      "type": "string",
      "pattern": "^R[0-9]+$",
      "description": "Linia wydania (R1 = MVP)."
    },
    "flag": {
      "type": "string",
      "minLength": 1,
      "description": "Klucz flagi, za którą jest cięcie."
    },
    "unblocks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
        "description": "Cięcia, które ten fundament odblokowuje."
      }
    },
    "skeleton": {
      "type": "boolean",
      "description": "Pierwsze cięcie end-to-end (szkielet)."
    }
  }
}
